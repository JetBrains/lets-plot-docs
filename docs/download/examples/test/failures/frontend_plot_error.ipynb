       "},\n",
       "\"geocoding\":{\n",
       "\"url\":\"https://geo2.datalore.jetbrains.com/map_data/geocoding\"\n",
       "},\n",
       "\"interactive\":true,\n",
       "\"data\":{\n",
       "}\n",
       "},{\n",
       "\"geom\":\"boxplot\",\n",
